 //____________________________________________________________________________________________________
+Int_t StFastGlauberMcMaker::InitOO(const TString type)
+{
+	/// Initialize O + O collisions
+	///
+	/// 16O nuclear density: 3-parameter Fermi (3pF) from electron scattering,
+	///   rho(r) ~ (1 + w r^2/R^2) / (1 + exp((r-R)/d)),  R = 2.608 fm, d = 0.513 fm, w = -0.051
+	///   H. De Vries, C.W. De Jager, C. De Vries, At. Data Nucl. Data Tables 36, 495 (1987)
+	///   (same 16O parameterization as TGlauberMC: C. Loizides, J. Kamin, D. d'Enterria, PRC 97, 054910 (2018))
+	///
+	/// 16O is treated as spherical (no beta2/beta4); no alpha clustering.
+	const UInt_t A   = 16 ;
+	const Double_t R = 2.608 ;
+	const Double_t d = 0.513 ;
+	const Double_t w = -0.051 ;
+
+	Double_t RError = 0.0 ; // Absolute error on R
+	Double_t dError = 0.0 ; // Absolute error on d
+
+	// No deformation parameters for 16O here: force spherical, otherwise Init() aborts on beta2=beta4=0
+	if( mIsDeformed[0] || mIsDeformed[1] ){
+		LOG_WARN << "StFastGlauberMcMaker::InitOO  Deformation was requested, but 16O is generated spherical (3pF). "
+			<< "Setting deformation flag to kFALSE" << endm ;
+		mIsDeformed[0] = kFALSE ;
+		mIsDeformed[1] = kFALSE ;
+	}
+	const Double_t beta2 = 0.0 ;
+	const Double_t beta4 = 0.0 ;
+
+	// Systematic variations follow the convention documented in Print("type") and submit_glauber.pl:
+	//   large: R +2%, d -10%      small: R -2%, d +10%
+	if ( type.CompareTo("large", TString::kIgnoreCase) == 0 ){
+		LOG_INFO << "StFastGlauberMcMaker::InitOO  Set large R, small d" << endm;
+		RError =  0.02 * R ;
+		dError = -0.10 * d ;
+	}
+	else if ( type.CompareTo("small", TString::kIgnoreCase) == 0 ){
+		LOG_INFO << "StFastGlauberMcMaker::InitOO  Set small R, large d" << endm;
+		RError = -0.02 * R ;
+		dError =  0.10 * d ;
+	}
+	else if ( type.CompareTo("gauss", TString::kIgnoreCase) == 0 ){
+		LOG_INFO << "StFastGlauberMcMaker::InitOO  Gaussian collision profile" << endm;
+		DoGaussianCollision() ;
+	}
+	else if ( type.CompareTo("smallNpp", TString::kIgnoreCase) == 0 ){
+		mMode = 1 ;
+		LOG_INFO << "StFastGlauberMcMaker::InitOO  Use small npp, large x for multiplicity (mMode = "
+			<< mMode << ")"
+			<< endm;
+	}
+	else if ( type.CompareTo("largeNpp", TString::kIgnoreCase) == 0 ){
+		mMode = 2 ;
+		LOG_INFO << "StFastGlauberMcMaker::InitOO  Use large npp, small x for multiplicity (mMode = "
+			<< mMode << ")"
+			<< endm;
+	}
+
+	mW[0] = w ;
+	mW[1] = w ;
+	LOG_INFO << "StFastGlauberMcMaker::InitOO  16O 3pF density: R = " << R+RError << " fm, d = " << d+dError
+		<< " fm, w = " << w << endm;
+
+	return Init(A, R+RError, d+dError, beta2, beta4, A, R+RError, d+dError, beta2, beta4, type);
+}
