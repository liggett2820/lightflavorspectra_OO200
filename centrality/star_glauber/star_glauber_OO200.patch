   //____________________________________________________________________________________________________
   // Woods-saxon density profile (2D for deformed nuclei)
+  //____________________________________________________________________________________________________
+  // Three-parameter Fermi density (spherical), with r^2 phase-space factor as in WoodsSaxon()
+  //   rho(r) ~ (1 + w r^2/R^2) / (1 + exp((r-R)/d))
+  // The (1 + w r^2/R^2) factor is clipped at 0: for w<0 it turns negative only at
+  // r > R/sqrt(|w|) (11.5 fm for 16O), where the Fermi factor is already < 1e-7,
+  // but TF1::GetRandom() must never see a negative value.
+  Double_t WoodsSaxon3pF(Double_t* x, Double_t* par)
+  {
+    const Double_t r = x[0] ;
+    const Double_t R = par[0] ;
+    const Double_t d = par[1] ;
+    const Double_t w = par[2] ;
+
+    const Double_t shape = 1.0 + w*r*r/(R*R) ;
+    if( shape <= 0.0 ) return 0.0 ;
+
+    return r*r*shape/(1.0+TMath::Exp((r-R)/d)) ;
+  }
